{
	log default {
		exclude http.log.error.vpn http.log.error.vpn_www
	}
	log vpn_errors {
		include http.log.error.vpn http.log.error.vpn_www
		output stderr
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
			}
		}
	}
}

gamelife.shop {
	log vpn {
		output discard
	}
	@decoy_loop header X-GameLife-Decoy-Loop 1
	handle @decoy_loop {
		respond "Not Found" 404
	}
	handle / {
		header Content-Type "text/html; charset=utf-8"
		respond "<!doctype html><html lang=ru><meta charset=utf-8><title>Жизнь</title><h1>Жизнь</h1></html>" 200
	}
	handle {
		reverse_proxy http://gamelife-vpn-origin:80 {
			header_up X-GameLife-Decoy-Loop 1
		}
	}
}

www.gamelife.shop {
	log vpn_www {
		output discard
	}
	redir https://gamelife.shop{uri} permanent
}
