[Unit]
Description=Update public VPN client routing data
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/gamelife-geodata/update.py
TimeoutStartSec=480
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
