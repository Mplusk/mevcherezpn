# Use this site block in the existing Caddy after configuring the origin certificate.
gamelife.shop {
	reverse_proxy https://127.0.0.1:28443 {
		header_up Host gamelife.shop
		transport http {
			tls_server_name gamelife.shop
			# For a privately signed origin, provision its public CA to Caddy:
			# tls_trust_pool file /etc/caddy/gamelife-origin-ca.pem
		}
	}
}
