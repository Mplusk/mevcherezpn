# Merge this logging configuration into the existing global options block.
# Site paths contain credentials; do not record request URIs or headers.
{
	log default {
		exclude http.log.error.vpn
	}
	log vpn_errors {
		include http.log.error.vpn
		output stderr
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
			}
		}
	}
}

# Set CADDY_NETWORK to the existing Caddy container's Docker network.
gamelife.shop {
	log vpn {
		output discard
	}
	reverse_proxy http://gamelife-vpn-origin:80
}
